# ===== 用户层：运行时生成或含个人信息，不入库（见 AGENTS.md Data Contract）=====

# 需求画像（入库的是 profile.example.yml）
config/profile.yml

# 画像语义层、速筛简版与家规（入库的是 *.template.md）
modes/_profile.md
modes/_custom.md
modes/_brief.md

# 运行时数据：整体忽略，只保留 .gitkeep 占位符——
# 新增的生成文件自动被覆盖，无需逐个补充规则
data/*
!data/.gitkeep
reports/*
!reports/.gitkeep

# ===== secrets 与本地环境 =====
.env
.env.*
**/.env.local
.mcp.json

# ===== AI 客户端本地会话数据（WorkBuddy 等；每台机器不同，不入库）=====
.workbuddy/

# ===== 依赖（dashboard 的 ink/react；脚本层本身零依赖）=====
node_modules/

# ===== 操作系统/编辑器杂物 =====
.DS_Store
Thumbs.db
*.swp
tmp/

# ===== 过程产物：本地设计稿与流程校验文件（不属于仓库内容）=====
designs/
docs/runtime-flow.*
